{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-azureprojectdev"
		},
		"AzureSqlDatabaselinkservice_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaselinkservice'"
		},
		"datalakelinkedservice_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'datalakelinkedservice'"
		},
		"AzureSqlDatabaselinkservice_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azureprojectdevserver.database.windows.net"
		},
		"AzureSqlDatabaselinkservice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azureprojectdevdatabase"
		},
		"AzureSqlDatabaselinkservice_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admindev"
		},
		"datalakelinkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://devstorageazuredatalake.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-azureprojectdev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabaselinkservice_password": {
						"value": "[parameters('AzureSqlDatabaselinkservice_password')]"
					},
					"datalakelinkedservice_accountKey": {
						"value": "[parameters('datalakelinkedservice_accountKey')]"
					},
					"AzureSqlDatabaselinkservice_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaselinkservice_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaselinkservice_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaselinkservice_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaselinkservice_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaselinkservice_properties_typeProperties_userName')]"
					},
					"datalakelinkedservice_properties_typeProperties_url": {
						"value": "[parameters('datalakelinkedservice_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}